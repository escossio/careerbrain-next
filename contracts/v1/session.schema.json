{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerbrain.invalid/contracts/v1/session.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "careerbrain.session.v1"
    },
    "access_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "refresh_token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "token_type": {
      "const": "Bearer"
    },
    "expires_in": {
      "const": 900
    }
  },
  "required": [
    "schema_version",
    "access_token",
    "refresh_token",
    "token_type",
    "expires_in"
  ],
  "additionalProperties": false
}
