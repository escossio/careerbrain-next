{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careerbrain.invalid/contracts/v1/identity.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "careerbrain.identity.v1"
    },
    "user_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "issuer": {
      "const": "https://accounts.google.com"
    },
    "subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "account_created_at": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "state": {
      "enum": [
        "ACTIVE",
        "DELETING"
      ]
    },
    "profile_status": {
      "enum": [
        "MISSING",
        "PROCESSING",
        "READY",
        "FAILED"
      ]
    }
  },
  "required": [
    "schema_version",
    "user_id",
    "tenant_id",
    "issuer",
    "subject",
    "account_created_at",
    "state",
    "profile_status"
  ],
  "additionalProperties": false
}
